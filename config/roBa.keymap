#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E    &kp R      &kp T                                                       &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D    &kp F      &kp G           &kp LG(SPACE)                &kp BACKSPACE  &kp H      &kp J  &kp K      &kp L    &kp COLON
&kp Z  &kp X  &kp C    &kp V      &kp B           &kp LANG1                    &kp SLASH      &kp N      &kp M  &kp COMMA  &kp DOT  &mo 1
&mo 5  &mo 2  &kp TAB  &kp LCTRL  &kp LEFT_SHIFT  &mt LEFT_COMMAND ESCAPE      &kp ENTER      &kp SPACE                             &to 2
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN>;
        };

        marks {
            bindings = <
&kp CARET       &kp TILDE    &kp PIPE         &kp LPAR  &kp RPAR                                         &kp INT_YEN       &none              &kp MINUS      &kp PLUS       &kp DOLLAR
&kp AT          &kp PERCENT  &kp EXCLAMATION  &kp LBKT  &kp RBKT  &kp LC(LS(SPACE))      &kp UNDERSCORE  &kp HASH          &kp ASTERISK       &kp UNDER      &kp EQUAL      &kp SEMICOLON
&kp LEFT_SHIFT  &kp GRAVE    &kp AMPS         &kp LBRC  &kp RBRC  &kp LA(LC(SPACE))      &trans          &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp BACKSLASH  &kp BACKSLASH  &trans
&trans          &trans       &trans           &trans    &trans    &trans                 &kp BACKSPACE   &mo 4                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT_ARROW>;
        };

        nums {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        functions {
            bindings = <
&kp LG(LS(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LG(LS(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(NUMBER_5))                                                  &kp LS(LG(NUMBER_6))  &kt LS(LG(NUMBER_7))  &kp LS(LG(NUMBER_8))  &kp LG(LS(NUMBER_9))  &kp LS(LG(NUMBER_0))
&kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp LG(LS(NUMBER_4))      &kp LS(LG(NUMBER_6))  &kp F6                &kp F7                &kp F8                &kp F9                &kp F10
&kp F11               &kp F12               &kp F13               &kp F14               &kp F15               &kp LS(LG(NUMBER_5))      &kp LS(LG(NUMBER_7))  &kp F16               &kp F17               &kp F18               &kp F19               &kp F20
&kp LC(LS(NUMBER_1))  &kp LS(LC(NUMBER_2))  &kp LC(LG(NUMBER_3))  &trans                &trans                &trans                    &trans                &trans                                                                                  &trans
            >;
        };

        gui {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp LG(MINUS)  &kp LG(PLUS)  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7         &kp F8        &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans         &trans        &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                                       &kp F12
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
